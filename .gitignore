# virtualenv
venv/
.venv/

# python
__pycache__/
*.pyc
*.pyo

# secrets / local config — NEVER commit keys
config.json
.free-llm-hub/
.env

# scratch commit-message files (never commit)
cm*.txt

# local hub run logs - never commit (may contain the control token)
.hublog.*

# zip-install auto-update baseline (per-install runtime state, never shipped)
.free-llm-hub-update-manifest.json

# hub runtime logs (local only)
hub.err.log
hub.err.log*
hub.out.log
hub.out.log*
graphify-out/
.opencode/

# Playwright MCP scratch output (screenshots, console logs)
.playwright-mcp/

# stray screenshots dropped in the repo root during debugging
image*.png

# Playwright/verification screenshots must never land in the repo.
*.png
!static/*.png

# transient test artifact from exercising run.bat
runbat.test.log
hub.start.err.log

# ad-hoc local debug scratch, not read by any app code
free_models.txt
list_keys.py
.calvoun-brief.md
.pytest-tmp/
